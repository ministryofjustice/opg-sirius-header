{
  "name": "opg-sirius-header",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "serve": "http-server",
    "serve-local": "http-server .",
    "compile-sass": "sass --load-path . --style compressed sass/main.scss public/css/all.css",
    "build:images": "mkdir -p web/static/assets/images && cp public/assets/images/* web/static/assets/images",
    "build:fonts": "mkdir -p web/static/assets/fonts && cp public/assets/fonts/* web/static/assets/fonts",
    "cypress": "cypress open",
    "cypress-headless": "cypress run --headless"
  },
  "devDependencies": {
    "@cypress/request": "^4.0.0",
    "@ministryofjustice/frontend": "^9.0.0",
    "axe-core": "^4.7.2",
    "cypress": "15.18.0",
    "cypress-axe": "1.7.0",
    "esbuild": "0.28.1",
    "govuk-frontend": "^6.3.0",
    "http-server": "v14.1.1",
    "sass": "^1.63.6",
    "cypress-failed-log": "2.10.0"
  }
}
